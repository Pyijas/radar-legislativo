# Escolha do provedor de IA usado para classificar os PLs: "anthropic", "gemini"
# ou "ollama". Se deixar em branco, usa "gemini" automaticamente quando
# GEMINI_API_KEY estiver preenchida, senão cai para "anthropic".
LLM_PROVIDER=

# --- Google Gemini (tem tier gratuito, sem cartão) ---
# Crie a sua em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Anthropic (Claude) ---
# Crie a sua em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Só necessário se sua chave for "identity-linked" (a API retorna um erro pedindo
# esse header explicitamente nesse caso). Encontre o ID na página do workspace em
# console.anthropic.com/settings/workspaces.
ANTHROPIC_WORKSPACE_ID=

# --- Ollama (modelo local, roda no seu próprio computador) ---
# Sem chave, sem custo por token, 100% offline — só precisa do serviço
# `ollama serve` rodando e do modelo baixado com `ollama pull <modelo>`.
# Defina LLM_PROVIDER=ollama acima pra ativar (não é escolhido automaticamente
# como o Gemini, porque exige esse setup local prévio).
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# --- Congresso dos EUA (fonte opcional, além da Câmara/Senado do Brasil) ---
# Cadastro gratuito (nome + e-mail, sem cartão) em https://api.congress.gov/sign-up/
# Sem essa chave, o Radar simplesmente pula a coleta dos EUA (não é obrigatória).
CONGRESS_API_KEY=

# --- Congresso do Chile ---
# Nenhuma chave necessária — o serviço de tramitação do Senado chileno é
# público e sem cadastro. Nada a configurar aqui; listado só pra referência.
